# Install :
# ollama create llava-fast -f llava-fast.Modelfile

# Указываем базовую модель, которую мы хотим оптимизировать (она должна быть скачана в Ollama)
FROM llava:latest

# 1. Ограничение размера контекста (в токенах)
# По умолчанию у Llava контекст равен 4096 токенам.
# Ваши картинки 256x144 очень маленькие (16КБ). Для них и для промта с лихвой хватит 1536 токенов.
# Это экономит ОЗУ и ускоряет обработку изображений в разы.
PARAMETER num_ctx 2048

# 2. Ограничение количества потоков процессора
# Для i7-1355U идеальное значение — 4 (задействуются только быстрые ядра на высокой частоте).
# Это предотвратит перегрев процессора и снизит задержки при вычислениях на CPU.
PARAMETER num_thread 4

# 3. Лимит длины ответа (в токенах)
# Если вам нужно краткое описание объектов с камер, ограничьте длину ответа.
# Модель не будет тратить время на дописывание ненужных предложений.
PARAMETER num_predict 400

# 4. Температура (Temperature)
# Низкая температура (0.2) делает ответы модели более стабильными, точными
# и уменьшает вероятность галлюцинаций (выдумок объектов на фото).
PARAMETER temperature 0.2

# 5. Штраф за повторения (Repeat Penalty)
# Предотвращает зацикливание модели на одних и тех же словах.
PARAMETER repeat_penalty 1.1

# 6. Системный промт (Дополнительная оптимизация)
# Задаем жесткую инструкцию, чтобы модель отвечала коротко и структурировано.
# SYSTEM """You are a low-latency security camera analyzer. Describe dynamic objects in 1-2 short sentences. Do not write introductory words, greetings, or background scenery details. Focus only on the main subject."""